#--------------------------------------------------------------------
# Promptiful: copia este archivo como `.env` y ajusta los valores.
# El archivo `.env` NO se sube al repositorio (contiene secretos).
#--------------------------------------------------------------------

# development en local; production en el servidor real
CI_ENVIRONMENT = development

# URL pública de la aplicación, con barra final
app.baseURL = 'http://localhost:8080/'

# Base de datos (producción: MySQL/MariaDB)
database.default.hostname = localhost
database.default.database = promptiful
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306

# Para probar sin MySQL: DBDriver = SQLite3 y database = promptiful.sqlite (se guarda en writable/)

# Activa esta línea cuando se sirva por HTTPS
# cookie.secure = true

